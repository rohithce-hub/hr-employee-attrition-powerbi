-- ============================================================
-- SORTING & UTILITY CALCULATED COLUMNS / MEASURES
-- Model: HR Employee Attrition
-- Author: Rohith Chandran E
-- Target Table: WA_Fn-UseC_-HR-Employee-Attrition
-- ============================================================

-- 1. Age Band Sort Key (Calculated Column)
-- Ensures age bins sort chronologically (18-25 -> 55+) instead of alphabetically
age_band_sort = 
SWITCH(
    'WA_Fn-UseC_-HR-Employee-Attrition'[age_band],
    "18-25", 1,
    "26-35", 2,
    "36-45", 3,
    "46-55", 4,
    "55+", 5,
    6
)


-- 2. Tenure Band Sort Key (Calculated Column)
-- Ensures tenure brackets sort in natural progression
tenure_band_sort = 
SWITCH(
    'WA_Fn-UseC_-HR-Employee-Attrition'[tenure_band],
    "0-2 Years", 1,
    "3-5 Years", 2,
    "6-10 Years", 3,
    "11-20 Years", 4,
    "20+ Years", 5,
    6
)


-- 3. Income Band Sort Key (Calculated Column)
-- Ensures salary tiers sort from lowest to highest compensation
income_band_sort = 
SWITCH(
    'WA_Fn-UseC_-HR-Employee-Attrition'[income_band],
    "< $3k", 1,
    "$3k-$5k", 2,
    "$5k-$10k", 3,
    "$10k-$15k", 4,
    "$15k+", 5,
    6
)
